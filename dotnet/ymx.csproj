<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# tree: every tool and rig the shell scripts reach with -dotnet.
       One assembly; Program.cs dispatches on the first argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ymx</AssemblyName>
    <RootNamespace></RootNamespace>
    <StartupObject>Program</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <PublishAot>true</PublishAot>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <!-- The SNDH cores and the PRG stub, carried in the assembly so a
       published ym-to-ymx combines without a repository beside it. dist/ is
       what ymx/mkcores.sh assembles into and is not in the tree, so a build
       made before that ran carries none and the combiners fall back to
       resolving them - which is what the shell scripts do anyway. -->
  <ItemGroup>
    <EmbeddedResource Include="../dist/release/*.bin" Condition="Exists('../dist/release')" />
    <EmbeddedResource Include="../dist/*.bin" Condition="!Exists('../dist/release')" />
  </ItemGroup>

</Project>
